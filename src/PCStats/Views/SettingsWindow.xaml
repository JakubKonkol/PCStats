<Window x:Class="PCStats.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PCStats.ViewModels"
        xmlns:models="clr-namespace:PCStats.Models"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="PC Stats – Settings"
        Width="860" Height="640" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Label + control row used across the appearance / behaviour tabs -->
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TileBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SmallIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Background="{StaticResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,1,10,0" />
                <TextBlock Text="Settings" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="{Binding HardwareSummary}" FontSize="11.5" Foreground="{StaticResource TextFaintBrush}" Margin="14,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Minimize" Click="OnMinimize" Width="34" Height="30" />
                <Button Style="{StaticResource DangerIconButton}" Content="&#xE8BB;" ToolTip="Close" Click="OnClose" Width="34" Height="30" />
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Margin="20,8,20,20">

            <!-- ======================= METRICS ======================= -->
            <TabItem Header="Metrics">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Available -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Available sensors" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="32,6,10,6" />
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False" />
                            <TextBlock Text="Search (e.g. temp, VRAM, fan)…" Foreground="{StaticResource TextFaintBrush}" FontSize="13"
                                       VerticalAlignment="Center" Margin="33,0,0,0" IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource StringToVis}, ConverterParameter=invert}" />
                        </Grid>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6" Margin="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding OptionsView}">
                                    <ItemsControl.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.ContainerStyle>
                                                <Style TargetType="GroupItem">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="GroupItem">
                                                                <Expander IsExpanded="True">
                                                                    <Expander.Header>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                                                            <TextBlock Text="{Binding ItemCount, StringFormat=' · {0}'}" FontSize="12" Foreground="{StaticResource TextFaintBrush}" />
                                                                        </StackPanel>
                                                                    </Expander.Header>
                                                                    <ItemsPresenter />
                                                                </Expander>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </GroupStyle.ContainerStyle>
                                        </GroupStyle>
                                    </ItemsControl.GroupStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MetricOptionViewModel}">
                                            <CheckBox Style="{StaticResource PickerCheck}" IsChecked="{Binding IsSelected}" ToolTip="{Binding Descriptor.Id}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontSize="13" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource TextFaintBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding LiveValue}" FontSize="12.5" FontWeight="SemiBold"
                                                               FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Center" Margin="12,0,4,0" MinWidth="64" TextAlignment="Right" />
                                                </Grid>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Selected -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Defaults" Padding="10,4" FontSize="12" Command="{Binding RestoreDefaultMetricsCommand}" />
                            <TextBlock Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center">
                                <Run Text="On the widget" /><Run Text="{Binding Selected.Count, Mode=OneWay, StringFormat=' · {0}'}" />
                            </TextBlock>
                        </DockPanel>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" Margin="0">
                            <ListBox ItemsSource="{Binding Selected}" SelectedItem="{Binding CurrentSelected}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SelectedMetricViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid>
                                                <TextBox x:Name="LabelBox" Text="{Binding CustomLabel, UpdateSourceTrigger=PropertyChanged}" Padding="8,4"
                                                         FontSize="12.5" ToolTip="Custom label (empty = default)" />
                                                <TextBlock Text="{Binding DefaultLabel}" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"
                                                           Visibility="{Binding Text, ElementName=LabelBox, Converter={StaticResource StringToVis}, ConverterParameter=invert}" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                                <Button Style="{StaticResource SmallIconButton}" Content="&#xE70E;" ToolTip="Move up"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource SmallIconButton}" Content="&#xE70D;" ToolTip="Move down"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource DangerIconButton}" Width="24" Height="24" FontSize="11" Content="&#xE711;" ToolTip="Remove"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <TextBlock Grid.Row="2" Style="{StaticResource RowHint}" Margin="2,10,0,0"
                                   Text="Tick sensors on the left. The order here is the order on the widget. Type a custom name to change a tile's label." />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ======================= APPEARANCE ======================= -->
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Layout" Style="{StaticResource RowLabel}" />
                                    <Border Grid.Column="1" CornerRadius="9" Background="{StaticResource TileBrush}" Padding="3" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" Content="Tiles" IsChecked="{Binding Layout, Converter={StaticResource EnumEquals}, ConverterParameter=Tiles}" />
                                            <RadioButton Style="{StaticResource Segment}" Content="List" IsChecked="{Binding Layout, Converter={StaticResource EnumEquals}, ConverterParameter=Compact}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,8,0,4" IsEnabled="{Binding Layout, Converter={StaticResource EnumEquals}, ConverterParameter=Tiles}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Columns" Style="{StaticResource RowLabel}" />
                                    <Border Grid.Column="1" CornerRadius="9" Background="{StaticResource TileBrush}" Padding="3" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" Content="1" IsChecked="{Binding Columns, Converter={StaticResource EnumEquals}, ConverterParameter=1}" />
                                            <RadioButton Style="{StaticResource Segment}" Content="2" IsChecked="{Binding Columns, Converter={StaticResource EnumEquals}, ConverterParameter=2}" />
                                            <RadioButton Style="{StaticResource Segment}" Content="3" IsChecked="{Binding Columns, Converter={StaticResource EnumEquals}, ConverterParameter=3}" />
                                            <RadioButton Style="{StaticResource Segment}" Content="4" IsChecked="{Binding Columns, Converter={StaticResource EnumEquals}, ConverterParameter=4}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Scale" Style="{StaticResource RowLabel}" />
                                    <Slider Grid.Column="1" Minimum="0.7" Maximum="1.8" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Scale}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Scale, Converter={StaticResource Format}, ConverterParameter=0%}" Style="{StaticResource RowLabel}" TextAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Background opacity" Style="{StaticResource RowLabel}" />
                                    <Slider Grid.Column="1" Minimum="0.15" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding BackgroundOpacity}" />
                                    <TextBlock Grid.Column="2" Text="{Binding BackgroundOpacity, Converter={StaticResource Format}, ConverterParameter=0%}" Style="{StaticResource RowLabel}" TextAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,8,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Accent colour" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                    <ItemsControl Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.AccentPresets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton GroupName="Accent" Cursor="Hand" Margin="0,0,8,8" Click="OnAccentClicked" Tag="{Binding}">
                                                    <RadioButton.IsChecked>
                                                        <MultiBinding Converter="{StaticResource StringEqualsMulti}" Mode="OneWay">
                                                            <Binding Path="DataContext.AccentColor" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding />
                                                        </MultiBinding>
                                                    </RadioButton.IsChecked>
                                                    <RadioButton.Template>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Grid Width="30" Height="30">
                                                                <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2" Margin="0" />
                                                                <Ellipse Fill="{Binding Converter={StaticResource HexToBrush}}" Margin="5" />
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Ring" Property="Stroke" Value="White" />
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource BorderStrongBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </RadioButton.Template>
                                                </RadioButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding ShowHeader}" Content="Header bar with buttons" />
                                <CheckBox IsChecked="{Binding ShowSparklines}" Content="History graphs (last 90 readings)" />
                                <CheckBox IsChecked="{Binding ShowBars}" Content="Progress bars under values" />
                            </StackPanel>
                        </Border>

                        <Button Content="Restore default appearance" HorizontalAlignment="Left" Command="{Binding RestoreDefaultAppearanceCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================= BEHAVIOUR ======================= -->
            <TabItem Header="Behaviour">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding AlwaysOnTop}" Content="Always on top" />
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding ClickThrough}" Content="Click-through (clicks pass through the widget)" />
                                    <TextBlock Style="{StaticResource RowHint}" Margin="0,-2,0,6"
                                               Text="While on, the widget cannot be dragged or clicked – turn it off from the tray icon menu." />
                                </StackPanel>
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding StartWithWindows}" Content="Start with Windows" />
                                    <TextBlock Style="{StaticResource RowHint}" Margin="0,-2,0,0"
                                               Text="Creates a Task Scheduler task with highest privileges, so there is no UAC prompt at every sign-in." />
                                    <TextBlock Style="{StaticResource RowHint}" Foreground="{StaticResource CriticalBrush}" Text="{Binding StartupError}"
                                               Visibility="{Binding StartupError, Converter={StaticResource StringToVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Refresh interval" Style="{StaticResource RowLabel}" />
                                    <Slider Grid.Column="1" Minimum="250" Maximum="5000" TickFrequency="250" IsSnapToTickEnabled="True" Value="{Binding UpdateIntervalMs}" />
                                    <TextBlock Grid.Column="2" Text="{Binding UpdateIntervalMs, Converter={StaticResource Format}, ConverterParameter='0 ms'}" Style="{StaticResource RowLabel}" TextAlignment="Right" />
                                </Grid>
                                <TextBlock Style="{StaticResource RowHint}" Text="1000 ms is a good balance. Below 500 ms reading the sensors starts to load the CPU noticeably." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Temperature thresholds" Style="{StaticResource RowLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Fill="{StaticResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Warning" Style="{StaticResource RowLabel}" />
                                    </StackPanel>
                                    <Slider Grid.Column="1" Minimum="50" Maximum="110" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TemperatureWarning}" />
                                    <TextBlock Grid.Column="2" Text="{Binding TemperatureWarning, Converter={StaticResource Format}, ConverterParameter='0 °C'}" Style="{StaticResource RowLabel}" TextAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Fill="{StaticResource CriticalBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Critical" Style="{StaticResource RowLabel}" />
                                    </StackPanel>
                                    <Slider Grid.Column="1" Minimum="50" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TemperatureCritical}" />
                                    <TextBlock Grid.Column="2" Text="{Binding TemperatureCritical, Converter={StaticResource Format}, ConverterParameter='0 °C'}" Style="{StaticResource RowLabel}" TextAlignment="Right" />
                                </Grid>
                                <TextBlock Style="{StaticResource RowHint}" Text="Memory (RAM / VRAM) is highlighted automatically at 90% and 97% usage." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding DriverStatus}" FontSize="12.5" />
                                <TextBlock Style="{StaticResource RowHint}"
                                           Text="CPU sensors (temperature, clocks, voltages) need the signed PawnIO driver (pawnio.eu). Its installer is built into PC Stats – the app restarts after installing it." />
                                <TextBlock Style="{StaticResource RowHint}" Foreground="{StaticResource CriticalBrush}" Text="{Binding DriverInstallError}"
                                           Visibility="{Binding DriverInstallError, Converter={StaticResource StringToVis}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Install PawnIO" Padding="10,5" FontSize="12" Margin="0,0,8,0" Command="{Binding InstallDriverCommand}"
                                            Visibility="{Binding IsDriverMissing, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Open log folder" Padding="10,5" FontSize="12" Command="{Binding OpenLogFolderCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
