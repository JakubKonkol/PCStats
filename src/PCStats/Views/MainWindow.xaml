<Window x:Class="PCStats.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PCStats.ViewModels"
        xmlns:controls="clr-namespace:PCStats.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="PC Stats"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="{Binding AlwaysOnTop}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}">

    <Window.Resources>
        <!-- Tile: label / big value / sparkline / bar / capacity hint -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type vm:MetricTileViewModel}">
            <Border x:Name="Tile" Width="150" Margin="4" Padding="13,10,13,11" CornerRadius="12"
                    Background="{StaticResource TileBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis" Typography.Capitals="AllSmallCaps" ToolTip="{Binding Descriptor.SensorName}" />

                    <TextBlock Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                        <Run x:Name="Value" Text="{Binding ValueText, Mode=OneWay}" FontSize="27" FontWeight="SemiBold"
                             FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource TextBrush}" />
                        <Run Text="{Binding UnitText, Mode=OneWay}" FontSize="12" FontWeight="Normal" Foreground="{StaticResource TextMutedBrush}" />
                    </TextBlock>

                    <controls:Sparkline x:Name="Spark" Height="24" Margin="0,5,0,5" Values="{Binding History}"
                                        Maximum="{Binding SparklineMaximum}" Stroke="{DynamicResource AccentBrush}"
                                        Capacity="{x:Static vm:MetricTileViewModel.HistoryLength}"
                                        Visibility="{Binding DataContext.ShowSparklines, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

                    <Grid Height="4" Margin="0,3,0,0" Visibility="{Binding HasBar, Converter={StaticResource BoolToVis}}">
                        <Border CornerRadius="2" Background="{StaticResource TrackBrush}" />
                        <Border x:Name="BarFill" CornerRadius="2" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding BarRatio}" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding SecondaryText}" FontSize="10.5" Margin="0,5,0,0" Foreground="{StaticResource TextFaintBrush}"
                               Visibility="{Binding SecondaryText, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource WarningBrush}" />
                    <Setter TargetName="BarFill" Property="Background" Value="{StaticResource WarningBrush}" />
                    <Setter TargetName="Spark" Property="Stroke" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource CriticalBrush}" />
                    <Setter TargetName="BarFill" Property="Background" Value="{StaticResource CriticalBrush}" />
                    <Setter TargetName="Spark" Property="Stroke" Value="{StaticResource CriticalBrush}" />
                    <Setter TargetName="Tile" Property="BorderBrush" Value="#66EF4444" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Compact row: label · value with a hairline bar underneath -->
        <DataTemplate x:Key="CompactTemplate" DataType="{x:Type vm:MetricTileViewModel}">
            <Grid Width="220" Margin="4,3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="Value" Grid.Column="1" Text="{Binding CompactText}" FontSize="13.5" FontWeight="SemiBold"
                           FontFamily="{StaticResource DisplayFont}" Margin="10,0,0,0" VerticalAlignment="Center" />
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Height="3" Margin="0,4,0,0" Visibility="{Binding HasBar, Converter={StaticResource BoolToVis}}">
                    <Border CornerRadius="1.5" Background="{StaticResource TrackBrush}" />
                    <Border x:Name="BarFill" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding BarRatio}" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource WarningBrush}" />
                    <Setter TargetName="BarFill" Property="Background" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource CriticalBrush}" />
                    <Setter TargetName="BarFill" Property="Background" Value="{StaticResource CriticalBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Settings…" Command="{Binding OpenSettingsCommand}" />
            <MenuItem Header="Toggle layout (tiles / list)" Command="{Binding ToggleLayoutCommand}" />
            <Separator />
            <MenuItem Header="Always on top" IsChecked="{Binding AlwaysOnTop, Mode=OneWay}" Command="{Binding ToggleAlwaysOnTopCommand}" />
            <MenuItem Header="Click-through" IsChecked="{Binding ClickThrough, Mode=OneWay}" Command="{Binding ToggleClickThroughCommand}" />
            <Separator />
            <MenuItem Header="Hide to tray" Command="{Binding HideToTrayCommand}" />
            <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border x:Name="Root" CornerRadius="16" Padding="10" Background="{Binding WindowBackground}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MouseLeftButtonDown="OnRootMouseLeftButtonDown">
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
        </Border.LayoutTransform>
        <StackPanel MinWidth="170">
            <!-- Header -->
            <DockPanel x:Name="Header" Margin="6,0,2,6" Visibility="{Binding ShowHeader, Converter={StaticResource BoolToVis}}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Opacity" Value="0.35" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Command="{Binding OpenSettingsCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Hide to tray" Command="{Binding HideToTrayCommand}" />
                    <Button Style="{StaticResource DangerIconButton}" Content="&#xE8BB;" ToolTip="Exit" Command="{Binding ExitCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,1,8,0" />
                    <TextBlock Text="PC STATS" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <!-- Status / loading -->
            <StackPanel Margin="6,4,6,6" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
                <Grid Height="3" Margin="0,10,0,4" Width="140" HorizontalAlignment="Left">
                    <Border CornerRadius="1.5" Background="{StaticResource TrackBrush}" />
                    <Border x:Name="Pulse" CornerRadius="1.5" Width="50" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}">
                        <Border.RenderTransform>
                            <TranslateTransform />
                        </Border.RenderTransform>
                        <!-- Started/stopped with IsLoading: a forever-looping storyboard on a collapsed element
                             would still drive the layered window to re-render every frame. -->
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="PulseStoryboard">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X"
                                                                     From="0" To="90" Duration="0:0:0.9">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="PulseStoryboard" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Empty state -->
            <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="6,2,6,6" Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" MaxWidth="240">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                    <Condition Binding="{Binding Tiles.Count}" Value="0" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Tiles -->
            <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}"
                          Visibility="{Binding IsCompact, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding Columns}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Compact list -->
            <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource CompactTemplate}" Margin="2,0,2,2"
                          Visibility="{Binding IsCompact, Converter={StaticResource BoolToVis}}" />

            <!-- Hint (e.g. missing driver) -->
            <Border Margin="4,6,4,0" Padding="10,7" CornerRadius="9" Background="#26F59E0B" BorderBrush="#66F59E0B" BorderThickness="1"
                    MaxWidth="330" Visibility="{Binding HintText, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding HintText}" FontSize="11" TextWrapping="Wrap" Foreground="#FDE68A" />
            </Border>
        </StackPanel>
    </Border>
</Window>
